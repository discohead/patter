{
  "name": "patter",
  "version": "0.1.0",
  "private": true,
  "description": "Describe a modular synthesis / generative system in natural language; an agent builds it on SuperSonic (scsynth in the browser).",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-supersonic.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p worker && cf build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "vitest run",
    "golden": "node scripts/golden.mjs",
    "deploy": "cf deploy"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.157",
    "@assistant-ui/react": "^0.15.31",
    "@assistant-ui/react-ai-sdk": "^1.4.20",
    "@cloudflare/ai-chat": "^0.12.2",
    "acorn": "^8.19.0",
    "agents": "^0.30.1",
    "ai": "^7.0.153",
    "astring": "^1.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "supersonic-scsynth": "^0.91.0",
    "supersonic-scsynth-core": "^0.91.0",
    "supersonic-scsynth-synthdefs": "^0.91.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.4",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "^1.0.0-beta.21",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
